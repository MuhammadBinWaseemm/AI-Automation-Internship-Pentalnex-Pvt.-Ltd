        "jsCode": "const clean = (v) => String(v ?? '').replace(/\\s+/g, ' ').trim();\n\nconst id = clean($json.id);\nconst topic = clean($json.topic);\nconst question = clean($json.question);\nconst answer = clean($json.answer);\n\nconst content = [\n  topic ? 'Topic: ' + topic : '',\n  question ? 'Question: ' + question : '',\n  answer ? 'Answer: ' + answer : '',\n].filter(Boolean).join('\\n');\n\nreturn { json: { id, topic, question, answer, content } };"
