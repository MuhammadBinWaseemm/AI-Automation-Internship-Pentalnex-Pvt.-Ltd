      "parameters": {
        "jsCode": "return items.map(item => {\n\nconst budget = Number(item.json.body.budget);\n\nlet score = 0;\nlet priority = \"\";\n\nif (budget >= 10000) {\n    score = 100;\n    priority = \"High\";\n}\nelse if (budget >= 5000) {\n    score = 70;\n    priority = \"Medium\";\n}\nelse {\n    score = 40;\n    priority = \"Low\";\n}\n\nreturn {\njson: {\n\nname: item.json.body.name,\n\nemail: item.json.body.email,\n\ncompany: item.json.body.company,\n\nservice: item.json.body.service,\n\nbudget: budget,\n\nlead_score: score,\n\npriority: priority\n\n}\n\n};\n\n});"
      },
