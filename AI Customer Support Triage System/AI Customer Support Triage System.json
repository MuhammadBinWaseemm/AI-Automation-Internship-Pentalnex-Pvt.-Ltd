    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI customer support triage assistant.\n\nAnalyze the customer's support message and classify it for an automated support system.\n\nYou MUST return structured data containing exactly these fields:\n\ncategory\npriority\nsentiment\ndepartment\nsummary\nsuggested_response\n\nCATEGORY:\nThe category MUST be exactly one of:\n- Billing\n- Technical Support\n- Account\n- Product\n- Complaint\n- General\n\nPRIORITY:\nThe priority MUST be exactly one of:\n- High\n- Medium\n- Low\n\nSENTIMENT:\nThe sentiment MUST be exactly one of:\n- Positive\n- Neutral\n- Negative\n\nDEPARTMENT:\nThe department MUST be exactly one of:\n- Billing\n- Technical Support\n- Account Management\n- Product Support\n- Customer Service\n- General\n\nRULES:\n- Analyze only the information contained in the customer message.\n- Do not invent customer information.\n- High priority should be used for urgent issues such as security concerns, account access problems, serious billing problems, service outages, or issues requiring immediate attention.\n- Medium priority should be used for normal support requests that require action but are not urgent.\n- Low priority should be used for general questions or non-urgent requests.\n- The summary must briefly explain the customer's issue.\n- suggested_response must be a professional and helpful response to the customer.\n- Do not include markdown outside the structured output.\n- Do not add extra fields.\n\nCUSTOMER MESSAGE:\n\n{{ $json.body.message }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "c334f7aa-ac6a-4443-b849-7907ac60b166",
      "name": "AI Analysis",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {}
      },
      "id": "3df9e591-2e06-4c5d-91b9-f29ea6dbac84",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        240,
        416
      ],
      "credentials": {
        "groqApi": {
          "id": "JSlKodqjNyKlu4na",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"category\":{\"type\":\"string\",\"enum\":[\"Billing\",\"Technical Support\",\"Account\",\"Product\",\"Complaint\",\"General\"]},\"priority\":{\"type\":\"string\",\"enum\":[\"High\",\"Medium\",\"Low\"]},\"sentiment\":{\"type\":\"string\",\"enum\":[\"Positive\",\"Neutral\",\"Negative\"]},\"department\":{\"type\":\"string\",\"enum\":[\"Billing\",\"Technical Support\",\"Account Management\",\"Product Support\",\"Customer Service\",\"General\"]},\"summary\":{\"type\":\"string\"},\"suggested_response\":{\"type\":\"string\"}},\"required\":[\"category\",\"priority\",\"sentiment\",\"department\",\"summary\",\"suggested_response\"],\"additionalProperties\":false}"
      },
      "id": "ed41220b-64bf-4ad5-a92e-118bb349e4b2",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        368,
        416
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "schema-valid",
              "leftValue": "={{ [\"Billing\",\"Technical Support\",\"Account\",\"Product\",\"Complaint\",\"General\"].includes($json.output && $json.output.category) && [\"High\",\"Medium\",\"Low\"].includes($json.output && $json.output.priority) && [\"Positive\",\"Neutral\",\"Negative\"].includes($json.output && $json.output.sentiment) && [\"Billing\",\"Technical Support\",\"Account Management\",\"Product Support\",\"Customer Service\",\"General\"].includes($json.output && $json.output.department) && !!($json.output && $json.output.summary) && !!($json.output && $json.output.suggested_response) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
