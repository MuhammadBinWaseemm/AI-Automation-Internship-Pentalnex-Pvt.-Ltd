      "id": "fde5da16-eec0-42b9-9f7f-ec0365ab6225",
      "name": "Set Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        480
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an email analysis assistant.\n\nAnalyze the provided email and return structured information.\n\nThe category MUST be exactly one of:\nSales, Support, Complaint, Invoice, Spam, General\n\nThe priority MUST be exactly one of:\nHigh, Medium, Low\n\nThe sentiment MUST be exactly one of:\nPositive, Neutral, Negative\n\nThe department MUST be exactly one of:\nSales, Support, Customer Service, Billing, IT, General\n\nRules:\n- Return ONLY the requested structured JSON.\n- Do not return markdown.\n- Do not return explanations outside the JSON.\n- Do not add extra fields.\n- category, priority, sentiment, department, and summary are all required.\n- summary must be a short description of the email.\n\nRequired output shape:\n\n{\n  \"category\": \"Sales\",\n  \"priority\": \"High\",\n  \"sentiment\": \"Positive\",\n  \"department\": \"Sales\",\n  \"summary\": \"Short summary of the email\"\n}\n\nEmail:\n{{ $json.email }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "6464a6e5-7a3d-4c12-bd43-036284e1669b",
      "name": "Classify Email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        448,
        480
      ]
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {}
      },
      "id": "8a692754-8243-40b9-835b-b9e8b54775a0",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        528,
        704
      ],
      "credentials": {
        "groqApi": {
          "id": "JSlKodqjNyKlu4na",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"category\":{\"type\":\"string\",\"enum\":[\"Sales\",\"Support\",\"Complaint\",\"Invoice\",\"Spam\",\"General\"]},\"priority\":{\"type\":\"string\",\"enum\":[\"High\",\"Medium\",\"Low\"]},\"sentiment\":{\"type\":\"string\",\"enum\":[\"Positive\",\"Neutral\",\"Negative\"]},\"department\":{\"type\":\"string\",\"enum\":[\"Sales\",\"Support\",\"Customer Service\",\"Billing\",\"IT\",\"General\"]},\"summary\":{\"type\":\"string\"}},\"required\":[\"category\",\"priority\",\"sentiment\",\"department\",\"summary\"],\"additionalProperties\":false}"
      },
      "id": "f70c3511-f7b3-4ca0-ad7a-c4c5a7ac5c69",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        368,
        832
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "schema-valid",
              "leftValue": "={{ [\"Sales\",\"Support\",\"Complaint\",\"Invoice\",\"Spam\",\"General\"].includes($json.output && $json.output.category) && [\"High\",\"Medium\",\"Low\"].includes($json.output && $json.output.priority) && [\"Positive\",\"Neutral\",\"Negative\"].includes($json.output && $json.output.sentiment) && [\"Sales\",\"Support\",\"Customer Service\",\"Billing\",\"IT\",\"General\"].includes($json.output && $json.output.department) && !!($json.output && $json.output.summary) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "833b66d3-31f2-411b-9213-cefb6c02533d",
