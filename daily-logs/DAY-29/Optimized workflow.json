      "parameters": {
        "jsCode": "// Non-PII triage log. Passes items through unchanged.\nconst items = $input.all();\nfor (const item of items) {\n  const j = item.json || {};\n  console.log(JSON.stringify({\n    log: 'ticket_triaged',\n    workflow: $workflow.name,\n    workflowId: $workflow.id,\n    executionId: $execution.id,\n    timestamp: new Date().toISOString(),\n    category: j.category,\n    priority: j.priority,\n    status: j.status,\n    urgentPathExpected: j.priority === 'High'\n  }));\n}\nreturn items;"
