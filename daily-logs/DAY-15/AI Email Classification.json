    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an email classification assistant.\n\nClassify the email into exactly one of these categories:\n- Sales\n- Support\n- Complaint\n- Invoice\n- Spam\n- General\n\nRules:\n- Return ONLY valid JSON.\n- Do not include explanations.\n- The output must follow exactly this format:\n\n{\n  \"category\": \"<Sales|Support|Complaint|Invoice|Spam|General>\"\n}\n\nEmail:\n{{ $json.email }}",
        "batching": {}
      },
      "id": "89e1722f-ef86-4f3d-862f-fbb331e61038",
      "name": "Classify Email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
