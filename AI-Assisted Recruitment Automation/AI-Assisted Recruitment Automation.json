    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || $json;\nconst clean = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst rand = Math.random().toString(36).slice(2, 7).toUpperCase();\nconst candidate_id = 'CAND-' + Date.now().toString(36).toUpperCase() + '-' + rand;\nreturn {\n  candidate_id,\n  name: clean(b.name),\n  email: clean(b.email),\n  degree: clean(b.degree),\n  skills: clean(b.skills),\n  experience: clean(b.experience),\n  availability: clean(b.availability),\n  created_at: new Date().toISOString(),\n};"
      },
