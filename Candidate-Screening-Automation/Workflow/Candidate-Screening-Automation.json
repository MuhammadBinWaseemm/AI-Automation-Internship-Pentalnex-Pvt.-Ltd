    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n\n    const experience = Number(item.json.Experience);\n    const skills = String(item.json.Skills).toLowerCase();\n    const availability = String(item.json.Availability).toLowerCase();\n\n    if (\n        experience >= 2 &&\n        availability === \"yes\" &&\n        (skills.includes(\"python\") || skills.includes(\"n8n\"))\n    ) {\n        item.json.Status = \"Shortlisted\";\n    }\n    else if (experience >= 1) {\n        item.json.Status = \"Needs Review\";\n    }\n    else {\n        item.json.Status = \"Not Eligible\";\n    }\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
