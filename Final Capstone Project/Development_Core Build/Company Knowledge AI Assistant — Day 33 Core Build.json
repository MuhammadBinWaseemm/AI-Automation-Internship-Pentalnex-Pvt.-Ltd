    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.chatInput;\n\n// A question must exist and be a string\nif (raw === undefined || raw === null || typeof raw !== 'string') {\n  return { valid: false, error: 'Question cannot be empty' };\n}\n\n// Trim whitespace and confirm it is not empty\nconst cleaned = raw.trim();\nif (cleaned === '') {\n  return { valid: false, error: 'Question cannot be empty' };\n}\n\nreturn { valid: true, question: cleaned };"
      },
      "id": "8c356f91-de6f-4672-862a-f562e76064a4",
      "name": "Validate User Question",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "df579d30-05ca-4e2c-a71c-82aeae395af4",
      "name": "Question Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        96
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const question = $json.question;\nconst lower = question.toLowerCase();\nconst received_at = new Date().toISOString();\n\n// RULE 3 — Priority detection\nconst urgentTerms = ['urgent', 'urgently', 'emergency', 'immediately', 'critical'];\nconst priority = urgentTerms.some(function (t) { return lower.includes(t); }) ? 'High' : 'Normal';\n\n// RULE 1 — Request length (too short)\nif (question.length < 5) {\n  return {\n    question: question,\n    request_type: 'unknown',\n    priority: priority,\n    status: 'rejected',\n    reason: 'Question is too short',\n    received_at: received_at,\n  };\n}\n\n// RULE 2 — Company knowledge detection\nconst knowledgeTerms = [\n  'company', 'policy', 'policies', 'sop', 'procedure', 'hr', 'leave',\n  'holiday', 'attendance', 'employee', 'work', 'office', 'remote',\n  'salary', 'benefits', 'security', 'onboarding', 'internship',\n  'working hours', 'guidelines'\n];\nconst isKnowledge = knowledgeTerms.some(function (t) { return lower.includes(t); });\n\n// RULE 4 — Final deterministic status\nif (isKnowledge) {\n  return {\n    question: question,\n    request_type: 'knowledge_query',\n    priority: priority,\n    status: 'approved_for_processing',\n    reason: 'Company knowledge request',\n    received_at: received_at,\n  };\n}\n\nreturn {\n  question: question,\n  request_type: 'unsupported_query',\n  priority: priority,\n  status: 'unsupported',\n  reason: 'Not identified as a company knowledge request',\n  received_at: received_at,\n};"
      },
      "id": "1e8f5235-d29b-4ab3-98ee-0356095973a0",
      "name": "Apply Business Rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
